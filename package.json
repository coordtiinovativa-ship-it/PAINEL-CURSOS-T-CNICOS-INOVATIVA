{
  "name": "certificados-iect",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Certificados — Instituto Inovativa (IECT)",
  "scripts": {
    "dev": "wrangler dev",
    "local": "node scripts/ambiente-local.mjs",
    "local:zerar": "node scripts/ambiente-local.mjs --zerar",
    "deploy": "wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "db:ficticios:local": "wrangler d1 execute DB --local --file=seed/dev_alunos_ficticios.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.18",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
